# Lead Hunter Kazakhstan — Environment Variables Example
# Для локальной разработки скопируйте этот файл в .env.local:
# cp .env.example .env.local

# 1. Supabase Cloud Database & Auth (Phase D)
# Получите URL и публичный anon-ключ в настройках проекта на supabase.com
# ВНИМАНИЕ: Используйте ТОЛЬКО публичный anon-ключ. НИКОГДА не сохраняйте service_role!
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 2. 2GIS Catalog API (Опционально: можно ввести в настройках интерфейса)
# Получить ключ: https://dev.2gis.kz/
VITE_2GIS_API_KEY=

# 3. Foursquare Places API (Опционально: можно ввести в настройках)
# Получить ключ ($200/мес бесплатно): https://location.foursquare.com/developer/
VITE_FOURSQUARE_API_KEY=

# 4. Google Places API (Опционально, требует биллинг в Google Cloud)
# Получить ключ: https://console.cloud.google.com/
VITE_GOOGLE_PLACES_API_KEY=
